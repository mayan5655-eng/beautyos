# Placeholders only. Real values live in Vercel (Production / Preview) and in the untracked .env.local. Never commit a secret.

# ── Grow (Meshulam) card payments ─────────────────────────────────────────────
# mock = no network, a test payment page on our own origin, nobody is charged (the default; refused on the Vercel production deployment)
# live = the real Grow API (needs the three platform values below)
GROW_MODE=mock
# Every Grow screen and signed-in Grow route is hidden until this is true. Default: off.
GROW_UI_ENABLED=false

# Live mode only. Issued by Grow when the platform onboarding is approved.
GROW_API_KEY=
GROW_PAGE_CODE=
# production for live, anything else is the sandbox. In production GROW_API_BASE is REQUIRED (given by Grow, not in the public docs).
GROW_ENV=sandbox
GROW_API_BASE=

# Optional: override Grow's published webhook IP list (comma separated). Only for testing; GROW_WEBHOOK_IP_CHECK=off works outside production only.
GROW_WEBHOOK_IPS=
GROW_WEBHOOK_IP_CHECK=

# 1 = inside WhatsApp / Instagram / Facebook the payment page opens Grow's wallet with credit card and Bit only (Apple Pay / Google Pay
# cannot run there), with "open in Safari / Chrome" kept as a secondary link. Empty = off (the open-in-browser prompt, as today).
# Turn on only after a real-device ₪1 test from WhatsApp.
GROW_INAPP_WALLET=

# ── WhatsApp Business Platform (Meta Cloud API) - docs/GO_LIVE_WHATSAPP.md ──────
# true = route utility messages that have an approved template through the official Cloud API. Default: off (GreenAPI / wa.me as today).
WA_CLOUD_ENABLED=false
# live = really call Meta. Anything else = mock: decisions and estimated cost are logged, GreenAPI keeps sending.
WA_CLOUD_MODE=mock
# From WhatsApp Manager (Phone Number ID, not the number) and a System User token with whatsapp_business_messaging.
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_ACCESS_TOKEN=
# App Secret of the WhatsApp Meta app (BeautyOS, 1464769648086912), for X-Hub-Signature-256. Not the Facebook leads app.
WA_CLOUD_APP_SECRET=
# Any long random string; the same value goes into the webhook setup in the Meta app.
WA_CLOUD_VERIFY_TOKEN=
WA_CLOUD_API_VERSION=v21.0
# Template sends per business per Israel day.
WA_CLOUD_TENANT_DAILY_CAP=150
# Estimate per utility template to +972, for the admin cost log only. Update from Meta's rate card.
WA_CLOUD_UTILITY_COST_USD=0.0053
# Template sends per business per Israel month, and for all businesses together per Israel day (every Cloud route).
WA_CLOUD_TENANT_MONTHLY_CAP=400
WA_CLOUD_GLOBAL_DAILY_CAP=2000
# Automatic reminders and booking confirmations with buttons (lib/waCloud/auto.ts, docs/WA_TEMPLATES.md).
# THE KILL SWITCH: true = may run (each business still turns it on herself). Anything else = off, nothing runs or shows.
WA_AUTO_ENABLED=false
# Hours before the visit for the reminder, by default (a business can choose 24 or 48).
WA_AUTO_REMINDER_LEAD_HOURS=24
# A money alert each time the month's estimated spend for all businesses passes a multiple of this (USD).
WA_AUTO_SPEND_ALERT_USD=25

# ── Phone verification at signup (lib/phoneVerify) ────────────────────────────
# off = nothing is sent and nobody is asked for a number (the default). mock = no SMS, the code is SMS_MOCK_CODE, only for
# the fake numbers 050-00000xx; refused on production, and on Vercel unless SMS_MOCK_ALLOWED=true. live = real SMS (costs money).
SMS_MODE=off
SMS_MOCK_CODE=
SMS_MOCK_ALLOWED=
# live only: 019 (Israeli, local price) or twilio
SMS_PROVIDER=
SMS_019_TOKEN=
SMS_019_USERNAME=
SMS_019_SOURCE=
# true = 019's test endpoint: validates the request, sends nothing
SMS_019_TEST=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Signs codes and signup tickets. A distinct random value; falls back to the service key with a loud log line.
PHONE_OTP_SECRET=
# All codes, all numbers, per day. Bounds the SMS bill. Default 300.
SMS_DAILY_CAP=

# ── Meta Pixel for Kalmea's own marketing (lib/metaPixel.ts) ─────────────────────
# Kalmea's pixel id (not a secret). Loads ONLY on the landing page and /signup, never in the app or on a business's
# public pages. Empty = nothing loads and the CSP never names Meta.
NEXT_PUBLIC_META_PIXEL_ID=
